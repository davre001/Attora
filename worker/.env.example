# --- Ethereum Sepolia (source chain) ---
# Local dev: point at a running `anvil` instance (see contracts/source/script/Deploy.s.sol)
SEPOLIA_RPC_URL=http://127.0.0.1:8545
SEPOLIA_CHAIN_ID=31337
# ConfidentialVault address from your local deploy
# (`forge script script/Deploy.s.sol --broadcast --rpc-url http://127.0.0.1:8545`)
# This changes on every fresh anvil instance — redeploy and update it.
VAULT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
# Block to start scanning for CollateralCommitted from (0 is fine for a fresh anvil)
SEPOLIA_START_BLOCK=0

# --- Attestcoin / Creditcoin CC3 testnet ---
# Sepolia's chainKey in CC3's attestation registry (README: "chainKey = 1")
ATTESTCOIN_CHAIN_KEY=1
PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network/
# RPC endpoint for CC3 testnet, used to read the ChainInfo precompile (0x...0fd3).
# See https://docs.attestcoin.org/attestcoin-protocol/attestcoin-protocol-chains-environments
CC3_RPC_URL=
# Optional override; defaults to the SDK's built-in precompile address (0x...0fd3)
# CHAIN_INFO_PRECOMPILE_ADDRESS=

# --- Worker service ---
DB_PATH=./data/attora.db
PORT=4000
